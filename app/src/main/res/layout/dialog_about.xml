<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/aboutIllustrationCompose"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="About DogCam"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="The perfect camera for pet lovers."
            android:textColor="#BBBBBB"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Features:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/featuresContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_pet_detection" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_shutter_sounds" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_watermarking" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_bounding_boxes" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_tap_to_focus" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_intelligent_ui" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_pro_storage" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_full_metadata" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_advanced_zoom" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_dual_camera" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_volume_shutter" />
            <TextView
                style="@style/AboutFeatureItem"
                android:text="@string/feature_smart_interlock" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="v1.0 • Play Store Ready"
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
